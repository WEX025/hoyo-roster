{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hoyo-game-data:schema:zenless-zone-zero:bangboos:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "game",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "zenless-zone-zero-bangboos/v1"
    },
    "game": {
      "const": "zenless-zone-zero"
    },
    "items": {
      "type": "object",
      "default": {},
      "propertyNames": {
        "$ref": "urn:hoyo-game-data:schema:common:definitions:v1#/$defs/stable_id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rarity",
          "level",
          "core_level"
        ],
        "properties": {
          "name": {
            "$ref": "urn:hoyo-game-data:schema:common:definitions:v1#/$defs/nonempty_string"
          },
          "rarity": {
            "$ref": "urn:hoyo-game-data:schema:common:definitions:v1#/$defs/nonnegative_integer"
          },
          "level": {
            "$ref": "urn:hoyo-game-data:schema:common:definitions:v1#/$defs/nonnegative_integer"
          },
          "core_level": {
            "$ref": "urn:hoyo-game-data:schema:common:definitions:v1#/$defs/nonnegative_integer"
          }
        }
      }
    }
  }
}
